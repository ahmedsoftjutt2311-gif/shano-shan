app.post('/api/admin/setup',async c=>{if(c.req.header('X-Admin-Setup-Key')!==c.env.ADMIN_SETUP_KEY)return json({error:'Invalid setup key'},403);const b=await c.req.json();if(String(b.password||'').length<12)return json({error:'Use a password of at least 12 characters'},400);const exists=await c.env.DB.prepare('SELECT 1 FROM staff LIMIT 1').first();if(exists)return json({error:'Admin already initialized'},409);const email=String(b.email||'').trim().toLowerCase(),name=String(b.name||'Owner').trim();const ph=await hashPassword(String(b.password));const u=await c.env.DB.prepare('INSERT INTO users(email,password_hash,name) VALUES(?,?,?)').bind(email,ph,name).run();const role:any=await c.env.DB.prepare("SELECT id FROM roles WHERE name='super_admin'").first();await c.env.DB.prepare('INSERT INTO staff(user_id,role_id) VALUES(?,?)').bind(u.meta.last_row_id,role.id).run();const perms=(await c.env.DB.prepare('SELECT id FROM permissions').all()).results;for(const p of perms as any[])await c.env.DB.prepare('INSERT OR IGNORE INTO role_permissions(role_id,permission_id) VALUES(?,?)').bind(role.id,p.id).run();return json({ok:true,message:'Initial admin created. You can now log in.'},201)});
app.get('/api/admin/dashboard',async c=>{const a=await requireStaff(c,'analytics');if('error'in a)return json({error:a.error},a.status);const q=async(sql:string)=>await c.env.DB.prepare(sql).first() as any;return json({sales:{today:(await q("SELECT COALESCE(SUM(total),0) n FROM orders WHERE date(created_at)=date('now') AND status NOT IN ('Cancelled','Refunded')")).n,month:(await q("SELECT COALESCE(SUM(total),0) n FROM orders WHERE strftime('%Y-%m',created_at)=strftime('%Y-%m','now') AND status NOT IN ('Cancelled','Refunded')")).n,total:(await q("SELECT COALESCE(SUM(total),0) n FROM orders WHERE status NOT IN ('Cancelled','Refunded')")).n},orders:{pending:(await q("SELECT COUNT(*) n FROM orders WHERE status='Pending'")).n,payment:(await q("SELECT COUNT(*) n FROM orders WHERE status='Payment Verification'")).n,processing:(await q("SELECT COUNT(*) n FROM orders WHERE status IN ('Confirmed','Processing','Packed')")).n,shipped:(await q("SELECT COUNT(*) n FROM orders WHERE status IN ('Shipped','Out for Delivery')")).n,delivered:(await q("SELECT COUNT(*) n FROM orders WHERE status='Delivered'")).n},products:{total:(await q('SELECT COUNT(*) n FROM products')).n,active:(await q('SELECT COUNT(*) n FROM products WHERE active=1')).n,low:(await q('SELECT COUNT(*) n FROM products WHERE active=1 AND stock>0 AND stock<=low_stock_threshold')).n,out:(await q('SELECT COUNT(*) n FROM products WHERE active=1 AND stock=0')).n},customers:{total:(await q('SELECT COUNT(*) n FROM users WHERE NOT EXISTS(SELECT 1 FROM staff WHERE staff.user_id=users.id)')).n}})});
app.get('/api/admin/products',async c=>{const a=await requireStaff(c,'products');if('error'in a)return json({error:a.error},a.status);return json({products:(await c.env.DB.prepare('SELECT * FROM products ORDER BY id DESC').all()).results})});
app.post('/api/admin/products',async c=>{const a=await requireStaff(c,'products');if('error'in a)return json({error:a.error},a.status);const b=await c.req.json();if(!b.name||!b.slug||Number.isNaN(Number(b.price)))return json({error:'Name, slug and price required'},400);try{const r=await c.env.DB.prepare(`INSERT INTO products(name,slug,sku,category_id,collection_id,gender,short_description,description,price,sale_price,stock,low_stock_threshold,weight,fragrance_family,top_notes,heart_notes,base_notes,longevity,sillage,ingredients,tags,badges,featured,best_seller,new_arrival,limited_edition,active,seo_title,seo_description,seo_keywords) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)`).bind(b.name,b.slug,b.sku||null,b.category_id||null,b.collection_id||null,b.gender||null,b.short_description||null,b.description||null,Number(b.price),b.sale_price===''?null:(b.sale_price??null),Number(b.stock||0),Number(b.low_stock_threshold||3),b.weight||null,b.fragrance_family||null,b.top_notes||null,b.heart_notes||null,b.base_notes||null,b.longevity||null,b.sillage||null,b.ingredients||null,b.tags||null,b.badges||null,Number(!!b.featured),Number(!!b.best_seller),Number(!!b.new_arrival),Number(!!b.limited_edition),b.active===false?0:1,b.seo_title||null,b.seo_description||null,b.seo_keywords||null).run();await log(c,a,'create','product',String(r.meta.last_row_id),null,b);return json({id:r.meta.last_row_id},201)}catch(e){return json({error:'Could not create product; check slug/SKU uniqueness'},400)}});
app.put('/api/admin/products/:id',async c=>{const a=await requireStaff(c,'products');if('error'in a)return json({error:a.error},a.status);const id=Number(c.req.param('id')),b=await c.req.json(),old=await c.env.DB.prepare('SELECT * FROM products WHERE id=?').bind(id).first();if(!old)return json({error:'Not found'},404);const allowed=['name','slug','sku','category_id','collection_id','gender','short_description','description','price','sale_price','stock','low_stock_threshold','weight','fragrance_family','top_notes','heart_notes','base_notes','longevity','sillage','ingredients','tags','badges','featured','best_seller','new_arrival','limited_edition','active','seo_title','seo_description','seo_keywords'];const sets:string[]=[];const vals:any[]=[];for(const k of allowed)if(k in b){sets.push(`${k}=?`);vals.push(b[k]===''?null:b[k])}if(!sets.length)return json({ok:true});sets.push('updated_at=CURRENT_TIMESTAMP');await c.env.DB.prepare(`UPDATE products SET ${sets.join(',')} WHERE id=?`).bind(...vals,id).run();await log(c,a,'update','product',String(id),old,b);return json({ok:true})});
app.post('/api/admin/products/:id/images',async c=>{const a=await requireStaff(c,'products');if('error'in a)return json({error:a.error},a.status);const id=Number(c.req.param('id')),p=await c.env.DB.prepare('SELECT id FROM products WHERE id=?').bind(id).first();if(!p)return json({error:'Not found'},404);const fd=await c.req.formData(),files=fd.getAll('files');const results=[];for(const f of files){if(!(f instanceof File)||f.size>10*1024*1024)continue;const up=await cloudinaryUpload(c,f,`shano-shan/products/${id}`);const r=await c.env.DB.prepare('INSERT INTO product_images(product_id,public_id,secure_url,width,height,format,is_primary,sort_order) VALUES(?,?,?,?,?,?,?,?)').bind(id,up.public_id,up.secure_url,up.width||null,up.height||null,up.format||null,0,Date.now()%1000000).run();await c.env.DB.prepare('INSERT OR IGNORE INTO media(public_id,secure_url,width,height,format) VALUES(?,?,?,?,?)').bind(up.public_id,up.secure_url,up.width||null,up.height||null,up.format||null).run();results.push({id:r.meta.last_row_id,url:up.secure_url})}return json({images:results})});
app.get('/api/admin/orders',async c=>{const a=await requireStaff(c,'orders');if('error'in a)return json({error:a.error},a.status);const q=c.req.query('q')||'',status=c.req.query('status')||'';let sql='SELECT * FROM orders WHERE 1=1',p:any[]=[];if(q){sql+=' AND (order_number LIKE ? OR name LIKE ? OR phone LIKE ?)';p.push(`%${q}%`,`%${q}%`,`%${q}%`)}if(status){sql+=' AND status=?';p.push(status)}sql+=' ORDER BY id DESC LIMIT 200';return json({orders:(await c.env.DB.prepare(sql).bind(...p).all()).results})});
app.get('/api/admin/orders/:id',async c=>{const a=await requireStaff(c,'orders');if('error'in a)return json({error:a.error},a.status);const id=Number(c.req.param('id'));const o=await c.env.DB.prepare('SELECT * FROM orders WHERE id=?').bind(id).first();if(!o)return json({error:'Not found'},404);const [items,payment]=await Promise.all([c.env.DB.prepare('SELECT * FROM order_items WHERE order_id=?').bind(id).all(),c.env.DB.prepare('SELECT p.*,r.secure_url receipt_url,r.public_id receipt_public_id FROM payments p LEFT JOIN payment_receipts r ON r.payment_id=p.id WHERE p.order_id=?').bind(id).first()]);return json({order:o,items:items.results,payment})});
app.patch('/api/admin/orders/:id/status',async c=>{const a=await requireStaff(c,'orders');if('error'in a)return json({error:a.error},a.status);const id=Number(c.req.param('id')),b=await c.req.json(),allowed=['Pending','Payment Verification','Confirmed','Processing','Packed','Shipped','Out for Delivery','Delivered','Cancelled','Returned','Refunded'];if(!allowed.includes(b.status))return json({error:'Invalid status'},400);const old=await c.env.DB.prepare('SELECT * FROM orders WHERE id=?').bind(id).first();await c.env.DB.prepare('UPDATE orders SET status=?,tracking_number=?,courier=?,tracking_url=?,internal_notes=?,updated_at=CURRENT_TIMESTAMP WHERE id=?').bind(b.status,b.tracking_number||null,b.courier||null,b.tracking_url||null,b.internal_notes||null,id).run();if((old as any)?.user_id)await c.env.DB.prepare('INSERT INTO notifications(user_id,title,body) VALUES(?,?,?)').bind((old as any).user_id,'Order update',`Your order ${((old as any).order_number)} is now ${b.status}.`).run();await log(c,a,'update_status','order',String(id),old,b);return json({ok:true})});
app.patch('/api/admin/payments/:id/verify',async c=>{const a=await requireStaff(c,'payments');if('error'in a)return json({error:a.error},a.status);const id=Number(c.req.param('id')),b=await c.req.json(),status=b.status==='Verified'?'Verified':'Rejected';const pay:any=await c.env.DB.prepare('SELECT * FROM payments WHERE id=?').bind(id).first();if(!pay)return json({error:'Payment not found'},404);await c.env.DB.prepare('UPDATE payments SET status=?,verified_by=?,verified_at=CURRENT_TIMESTAMP,note=? WHERE id=?').bind(status,a.user.id,b.note||null,id).run();await c.env.DB.prepare('UPDATE orders SET payment_status=?,status=?,updated_at=CURRENT_TIMESTAMP WHERE id=?').bind(status,status==='Verified'?'Confirmed':'Payment Verification',pay.order_id).run();await log(c,a,status==='Verified'?'approve_payment':'reject_payment','payment',String(id),pay,b);return json({ok:true})});
app.get('/api/admin/content/:key',async c=>{const a=await requireStaff(c,'content');if('error'in a)return json({error:a.error},a.status);const key=c.req.param('key');const s=await c.env.DB.prepare('SELECT value FROM settings WHERE key=?').bind(key).first() as any;return json({key,value:s?.value||''})});
app.put('/api/admin/content/:key',async c=>{const a=await requireStaff(c,'content');if('error'in a)return json({error:a.error},a.status);const key=c.req.param('key'),b=await c.req.json();await c.env.DB.prepare('INSERT INTO settings(key,value,updated_at) VALUES(?,?,CURRENT_TIMESTAMP) ON CONFLICT(key) DO UPDATE SET value=excluded.value,updated_at=CURRENT_TIMESTAMP').bind(key,String(b.value||'')).run();await log(c,a,'update_content','setting',key,null,b);return json({ok:true})});
app.get('/api/admin/settings',async c=>{const a=await requireStaff(c,'settings');if('error'in a)return json({error:a.error},a.status);return c.json({settings:Object.fromEntries((await c.env.DB.prepare('SELECT key,value FROM settings').all()).results.map((r:any)=>[r.key,r.value]))})});
app.put('/api/admin/settings',async c=>{const a=await requireStaff(c,'settings');if('error'in a)return json({error:a.error},a.status);const b=await c.req.json();for(const [k,v] of Object.entries(b))await c.env.DB.prepare('INSERT INTO settings(key,value,updated_at) VALUES(?,?,CURRENT_TIMESTAMP) ON CONFLICT(key) DO UPDATE SET value=excluded.value,updated_at=CURRENT_TIMESTAMP').bind(k,String(v)).run();await log(c,a,'update_settings','settings',undefined,null,b);return json({ok:true})});
app.get('/api/admin/banners',async c=>{const a=await requireStaff(c,'content');if('error'in a)return json({error:a.error},a.status);return c.json({banners:(await c.env.DB.prepare('SELECT * FROM banners ORDER BY sort_order,id').all()).results})});
app.post('/api/admin/banners',async c=>{const a=await requireStaff(c,'content');if('error'in a)return json({error:a.error},a.status);const b=await c.req.json();const r=await c.env.DB.prepare('INSERT INTO banners(title,subtitle,cta_text,cta_url,desktop_url,mobile_url,video_url,start_at,end_at,active,sort_order) VALUES(?,?,?,?,?,?,?,?,?,?,?)').bind(b.title||null,b.subtitle||null,b.cta_text||null,b.cta_url||null,b.desktop_url||null,b.mobile_url||null,b.video_url||null,b.start_at||null,b.end_at||null,b.active===false?0:1,Number(b.sort_order||0)).run();return json({id:r.meta.last_row_id},201)});
app.get('/api/admin/export/orders.csv',async c=>{const a=await requireStaff(c,'orders');if('error'in a)return json({error:a.error},a.status);const rows=(await c.env.DB.prepare('SELECT order_number,created_at,name,phone,email,address,city,subtotal,discount,delivery_fee,total,payment_method,payment_status,status,tracking_number,courier FROM orders ORDER BY id DESC').all()).results as any[];const esc=(v:any)=>`"${String(v??'').replaceAll('"','""')}"`;const csv=[Object.keys(rows[0]||{order_number:'',created_at:'',name:'',phone:'',email:'',address:'',city:'',subtotal:'',discount:'',delivery_fee:'',total:'',payment_method:'',payment_status:'',status:'',tracking_number:'',courier:''}).join(','),...rows.map(r=>Object.values(r).map(esc).join(','))].join('\n');return new Response(csv,{headers:{'content-type':'text/csv; charset=utf-8','content-disposition':'attachment; filename="shano-shan-orders.csv"'}})});

