async function cart(c:any){const u=await userFromReq(c),guest=c.req.header('X-Cart-ID')||null;let row:any=u?await c.env.DB.prepare('SELECT * FROM carts WHERE user_id=?').bind(u.id).first():guest?await c.env.DB.prepare('SELECT * FROM carts WHERE guest_token=?').bind(guest).first():null;if(!row){if(u){const r=await c.env.DB.prepare('INSERT INTO carts(user_id) VALUES(?)').bind(u.id).run();row={id:r.meta.last_row_id,user_id:u.id}}else{const gt=guest||await sessionToken();const r=await c.env.DB.prepare('INSERT INTO carts(guest_token) VALUES(?)').bind(gt).run();row={id:r.meta.last_row_id,guest_token:gt}}}return {row,u,guest}}
app.get('/api/cart',async c=>{const {row}=await cart(c);const items=await c.env.DB.prepare('SELECT ci.*,p.name,p.slug,p.price,p.sale_price,p.stock,(SELECT secure_url FROM product_images i WHERE i.product_id=p.id ORDER BY i.is_primary DESC,i.sort_order LIMIT 1) image_url FROM cart_items ci JOIN products p ON p.id=ci.product_id WHERE ci.cart_id=?').bind(row.id).all();return json({cart:{...row,items:items.results}})});
app.post('/api/cart/items',async c=>{const b=await c.req.json(),qty=Math.max(1,Math.min(99,Number(b.quantity||1))),pid=Number(b.product_id),vid=b.variant_id?Number(b.variant_id):null;const {row}=await cart(c);const p:any=vid?await c.env.DB.prepare('SELECT * FROM product_variants WHERE id=? AND product_id=?').bind(vid,pid).first():await c.env.DB.prepare('SELECT * FROM products WHERE id=? AND active=1').bind(pid).first();if(!p)return json({error:'Product or variant unavailable'},404);const stock=Number(p.stock);const existing:any=await c.env.DB.prepare('SELECT quantity FROM cart_items WHERE cart_id=? AND product_id=? AND variant_id IS ?').bind(row.id,pid,vid).first();if((existing?.quantity||0)+qty>stock)return json({error:'Not enough stock'},400);if(existing)await c.env.DB.prepare('UPDATE cart_items SET quantity=quantity+? WHERE cart_id=? AND product_id=? AND variant_id IS ?').bind(qty,row.id,pid,vid).run();else await c.env.DB.prepare('INSERT INTO cart_items(cart_id,product_id,variant_id,quantity) VALUES(?,?,?,?)').bind(row.id,pid,vid,qty).run();return json({ok:true})});
app.patch('/api/cart/items/:id',async c=>{const b=await c.req.json(),qty=Math.max(1,Math.min(99,Number(b.quantity||1)));const {row}=await cart(c);const item:any=await c.env.DB.prepare('SELECT ci.*,COALESCE(v.stock,p.stock) stock FROM cart_items ci JOIN products p ON p.id=ci.product_id LEFT JOIN product_variants v ON v.id=ci.variant_id WHERE ci.id=? AND ci.cart_id=?').bind(Number(c.req.param('id')),row.id).first();if(!item||qty>item.stock)return json({error:'Invalid quantity'},400);await c.env.DB.prepare('UPDATE cart_items SET quantity=? WHERE id=? AND cart_id=?').bind(qty,item.id,row.id).run();return json({ok:true})});
