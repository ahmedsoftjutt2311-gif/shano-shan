async function productDetail(c:any,p:any){const [images,variants]=await Promise.all([c.env.DB.prepare('SELECT * FROM product_images WHERE product_id=? ORDER BY sort_order,id').bind(p.id).all(),c.env.DB.prepare('SELECT * FROM product_variants WHERE product_id=? ORDER BY id').bind(p.id).all()]);return {...p,images:images.results,variants:variants.results}}
app.get('/api/products',async c=>{const q=c.req.query('q')||'',cat=c.req.query('category'),gender=c.req.query('gender'),page=Math.max(1,Number(c.req.query('page')||1)),limit=Math.min(48,Math.max(1,Number(c.req.query('limit')||12))),offset=(page-1)*limit;let where='WHERE p.active=1',params:any[]=[];if(q){where+=' AND (p.name LIKE ? OR p.sku LIKE ? OR p.tags LIKE ?)';params.push(`%${q}%`,`%${q}%`,`%${q}%`)}if(cat){where+=' AND (p.category_id=? OR c.slug=?)';params.push(Number(cat)||0,cat)}if(gender){where+=' AND p.gender=?';params.push(gender)}const count=await c.env.DB.prepare(`SELECT COUNT(*) n FROM products p LEFT JOIN categories c ON c.id=p.category_id ${where}`).bind(...params).first() as any;const rows=await c.env.DB.prepare(`SELECT p.*,c.name category_name,c.slug category_slug,(SELECT secure_url FROM product_images i WHERE i.product_id=p.id ORDER BY i.is_primary DESC,i.sort_order LIMIT 1) image_url FROM products p LEFT JOIN categories c ON c.id=p.category_id ${where} ORDER BY p.featured DESC,p.new_arrival DESC,p.id DESC LIMIT ? OFFSET ?`).bind(...params,limit,offset).all();return json({products:rows.results,page,limit,total:Number(count?.n||0)})});
