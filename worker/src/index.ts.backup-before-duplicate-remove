const json=(data:unknown,status=200)=>new Response(JSON.stringify(data),{status,headers:{'content-type':'application/json'}});
const now=()=>new Date().toISOString();
const b64=(u:Uint8Array)=>btoa(String.fromCharCode(...u));
const hex=(u:Uint8Array)=>Array.from(u).map(x=>x.toString(16).padStart(2,'0')).join('');
async function digest(text:string,alg:'SHA-256'|'SHA-1'='SHA-256'){return hex(new Uint8Array(await crypto.subtle.digest(alg,new TextEncoder().encode(text))))}
async function hashPassword(password:string,salt?:Uint8Array<ArrayBuffer>){const s=salt||crypto.getRandomValues(new Uint8Array(16));const key=await crypto.subtle.importKey('raw',new TextEncoder().encode(password),'PBKDF2',false,['deriveBits']);const bits=await crypto.subtle.deriveBits({name:'PBKDF2',salt:new Uint8Array(s),iterations:100000,hash:'SHA-256'},key,256);return `pbkdf2$100000$${b64(s)}$${b64(new Uint8Array(bits))}`}
async function verifyPassword(password:string,stored:string){const [,it,salt,hash]=stored.split('$');const s=Uint8Array.from(atob(salt),c=>c.charCodeAt(0));const key=await crypto.subtle.importKey('raw',new TextEncoder().encode(password),'PBKDF2',false,['deriveBits']);const bits=await crypto.subtle.deriveBits({name:'PBKDF2',salt:s,iterations:Number(it),hash:'SHA-256'},key,256);return b64(new Uint8Array(bits))===hash}
async function sessionToken(){return b64(crypto.getRandomValues(new Uint8Array(32))).replace(/[^a-zA-Z0-9]/g,'')}
async function userFromReq(c:any){const h=c.req.header('Authorization')||'';if(!h.startsWith('Bearer '))return null;const token=h.slice(7);const th=await digest(token);return await c.env.DB.prepare("SELECT u.*,s.expires_at FROM sessions s JOIN users u ON u.id=s.user_id WHERE s.token_hash=? AND s.expires_at>? AND u.status='active'").bind(th,now()).first() as any}
async function staffFromReq(c:any){const u=await userFromReq(c);if(!u)return null;const s=await c.env.DB.prepare('SELECT st.*,r.name role FROM staff st JOIN roles r ON r.id=st.role_id WHERE st.user_id=? AND st.active=1').bind(u.id).first() as any;return s?{user:u,staff:s}:null}
async function requireStaff(c:any,permission?:string){const s=await staffFromReq(c);if(!s)return {error:'Unauthorized',status:401};if(s.staff.role==='super_admin')return s;if(permission){const p=await c.env.DB.prepare('SELECT 1 FROM role_permissions rp JOIN permissions p ON p.id=rp.permission_id WHERE rp.role_id=? AND p.name=?').bind(s.staff.role_id,permission).first();if(!p)return {error:'Forbidden',status:403}}return s}
async function log(c:any,staff:any,action:string,entity:string,id?:string,prev?:any,next?:any){await c.env.DB.prepare('INSERT INTO activity_logs(staff_user_id,action,entity,entity_id,previous_value,new_value,ip) VALUES(?,?,?,?,?,?,?)').bind(staff?.user?.id||null,action,entity,id||null,prev?JSON.stringify(prev):null,next?JSON.stringify(next):null,c.req.header('CF-Connecting-IP')||null).run()}
app.use('*', async (c, next) => {
  const origin = c.req.header('Origin') || '';
  const allowedOrigins = [
    'https://shanoshanfragrance.netlify.app',
    'https://shanoshanfragranceadmin.netlify.app',
    ...(c.env.ALLOWED_ORIGINS || '')
      .split(',')
      .map((x: string) => x.trim())
      .filter(Boolean),
  ];

  if (c.req.method === 'OPTIONS') {
    if (origin && !allowedOrigins.includes(origin)) {
      return new Response(JSON.stringify({ error: 'Origin not allowed' }), {
        status: 403,
        headers: { 'Content-Type': 'application/json' },
      });
    }

    return new Response(null, {
      status: 204,
      headers: {
        'Access-Control-Allow-Origin': origin,
        'Access-Control-Allow-Methods': 'GET,POST,PUT,PATCH,DELETE,OPTIONS',
        'Access-Control-Allow-Headers': 'Content-Type,Authorization,X-Cart-ID',
        'Access-Control-Allow-Credentials': 'true',
        'Access-Control-Max-Age': '86400',
        'Vary': 'Origin',
      },
    });
  }

  await next();

  if (origin && allowedOrigins.includes(origin)) {
    c.header('Access-Control-Allow-Origin', origin);
    c.header('Access-Control-Allow-Methods', 'GET,POST,PUT,PATCH,DELETE,OPTIONS');
    c.header('Access-Control-Allow-Headers', 'Content-Type,Authorization,X-Cart-ID');
    c.header('Access-Control-Allow-Credentials', 'true');
    c.header('Vary', 'Origin');
  }
});
