type Env={Bindings:{DB:D1Database;ALLOWED_ORIGINS:string;SESSION_SECRET:string;CLOUDINARY_CLOUD_NAME:string;CLOUDINARY_API_KEY:string;CLOUDINARY_API_SECRET:string;ADMIN_SETUP_KEY:string}};
