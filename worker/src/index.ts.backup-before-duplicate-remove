async function cloudinaryUpload(c:any,file:File,folder:string){const timestamp=Math.floor(Date.now()/1000);const signature=await digest(`folder=${folder}&timestamp=${timestamp}${c.env.CLOUDINARY_API_SECRET}`,'SHA-1');const fd=new FormData();fd.append('file',file);fd.append('api_key',c.env.CLOUDINARY_API_KEY);fd.append('timestamp',String(timestamp));fd.append('folder',folder);fd.append('signature',signature);const r=await fetch(`https://api.cloudinary.com/v1_1/${c.env.CLOUDINARY_CLOUD_NAME}/auto/upload`,{method:'POST',body:fd});if(!r.ok)throw new Error('Cloudinary upload failed');return await r.json() as any}
